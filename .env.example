# ---- OpenRouter (the agent's brain; any tool-capable model) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# ---- Alpaca paper trading (Home → API Keys → Generate) ----
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ---- AgntID runtime (docker compose from the agntid-python repo) ----
# Set to http://localhost:8082/mcp once the runtime is up. Empty = built-in Kosh policy engine enforces.
AGNTID_MCP_URL=
AGNTID_ACCESS_TOKEN=
AGNTID_AGENT_ID=kosh-treasury-agent

# ---- Supabase (optional; in-memory store is used when empty) ----
# Run supabase/schema.sql first. The server uses the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
